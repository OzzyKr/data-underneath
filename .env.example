# Insights AI. Copy to .env and fill in ONE provider (or leave empty to run offline from the cache).
# The provider can also be switched in the dashboard's top bar (Insights page).

AI_PROVIDER=anthropic           # anthropic | openai | none
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium              # low | medium | high

# Any OpenAI-compatible endpoint: OpenAI, Azure, Gemini, Groq, Mistral, a local Ollama ...
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
